(edif ORIENTCODES
  (edifVersion 2 0 0)
  (edifLevel 0)
  ; One three-pin part, which no turn or flip maps onto itself, placed once per EDIF orientation
  ; code: U1-U8 are R0 R90 R180 R270 MX MY MXR90 MYR90 (agni issue 1344).
  (library L
    (technology (numberDefinition (scale 1 (e 1 -8) (unit DISTANCE))))
    (cell (rename &c "Tri")
      (cellType GENERIC)
      (view (rename &v "sym")
        (viewType SCHEMATIC)
        (interface (port P1 (direction INPUT) (designator "1")) (port P2 (direction INPUT) (designator "2")) (port P3 (direction INPUT) (designator "3")))
        (symbol
          (boundingBox (rectangle (pt 0 0) (pt 600 400)))
          (figure BOX (rectangle (pt 100 0) (pt 500 300)))
          (portImplementation (name P1) (connectLocation (figure GRAPHICS (dot (pt 0 0)))))
          (portImplementation (name P2) (connectLocation (figure GRAPHICS (dot (pt 600 0)))))
          (portImplementation (name P3) (connectLocation (figure GRAPHICS (dot (pt 0 400)))))))))
  (design D
    (cellRef Top (libraryRef L))
    (contents
      (page (rename P1 "S1")
        (pageSize (rectangle (pt 0 0) (pt 9000 5000)))
        (instance (rename &u1 "$u1")
          (viewRef v (cellRef (name &c) (libraryRef L)))
          (transform (origin (pt 1000 1000)) (orientation R0))
          (designator (stringDisplay "U1")))
        (instance (rename &u2 "$u2")
          (viewRef v (cellRef (name &c) (libraryRef L)))
          (transform (origin (pt 3000 1000)) (orientation R90))
          (designator (stringDisplay "U2")))
        (instance (rename &u3 "$u3")
          (viewRef v (cellRef (name &c) (libraryRef L)))
          (transform (origin (pt 5000 1000)) (orientation R180))
          (designator (stringDisplay "U3")))
        (instance (rename &u4 "$u4")
          (viewRef v (cellRef (name &c) (libraryRef L)))
          (transform (origin (pt 7000 1000)) (orientation R270))
          (designator (stringDisplay "U4")))
        (instance (rename &u5 "$u5")
          (viewRef v (cellRef (name &c) (libraryRef L)))
          (transform (origin (pt 1000 3000)) (orientation MX))
          (designator (stringDisplay "U5")))
        (instance (rename &u6 "$u6")
          (viewRef v (cellRef (name &c) (libraryRef L)))
          (transform (origin (pt 3000 3000)) (orientation MY))
          (designator (stringDisplay "U6")))
        (instance (rename &u7 "$u7")
          (viewRef v (cellRef (name &c) (libraryRef L)))
          (transform (origin (pt 5000 3000)) (orientation MXR90))
          (designator (stringDisplay "U7")))
        (instance (rename &u8 "$u8")
          (viewRef v (cellRef (name &c) (libraryRef L)))
          (transform (origin (pt 7000 3000)) (orientation MYR90))
          (designator (stringDisplay "U8")))))))
