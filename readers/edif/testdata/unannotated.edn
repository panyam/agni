      (instance (rename &i1 "$i1") (viewRef V (cellRef RES (libraryRef L))) (designator "R?"))
      (instance (rename &i2 "$i2") (viewRef V (cellRef RES (libraryRef L))) (designator "R?"))
      (instance (rename &i3 "$i3") (viewRef V (cellRef CAP (libraryRef L))) (designator "C?"))
      (instance (rename &i4 "$i4") (viewRef V (cellRef RES (libraryRef L))) (designator "R7"))
