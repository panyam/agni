(edif HIER
  (edifVersion 2 0 0)
  (design HIER (cellRef TOP (libraryRef WORK)))
  (library PARTS
    (cell RES (cellType GENERIC)
      (view V (viewType NETLIST) (interface (designator "R") (port A) (port B))))
    (cell CAP (cellType GENERIC)
      (view V (viewType NETLIST) (interface (designator "C") (port &1) (port &2))))
    (cell LED (cellType GENERIC)
      (view V (viewType NETLIST) (interface (designator "D") (port A) (port K))))
    (cell CONN2 (cellType GENERIC)
      (view V (viewType NETLIST) (interface (designator "J") (port &1) (port &2))))
    (cell TP (cellType GENERIC)
      (view V (viewType NETLIST) (interface (designator "TP") (port &1))))
    (cell BUF2 (cellType GENERIC)
      (view V (viewType NETLIST) (interface (designator "U") (port IN) (port OUT)))))
  (library WORK
    (cell LED_DRV (cellType GENERIC)
      (view V (viewType NETLIST)
        (interface (port VIN) (port CATH))
        (contents
          (instance R1 (viewRef V (cellRef RES (libraryRef PARTS))) (designator "R1"))
          (instance D1 (viewRef V (cellRef LED (libraryRef PARTS))) (designator "D1"))
          (instance U5B (viewRef V (cellRef BUF2 (libraryRef PARTS))) (designator "U5")
            (portInstance IN (designator "3")) (portInstance OUT (designator "4")))
          (net VIN (joined (portRef VIN) (portRef A (instanceRef R1))))
          (net MID (joined (portRef B (instanceRef R1)) (portRef A (instanceRef D1)) (portRef IN (instanceRef U5B))))
          (instance TP2 (viewRef V (cellRef TP (libraryRef PARTS))) (designator "TP2"))
          (net SENSE (joined (portRef &1 (instanceRef TP2))))
          (net CATH (joined (portRef K (instanceRef D1)) (portRef OUT (instanceRef U5B)) (portRef CATH))))))
    (cell RC (cellType GENERIC)
      (view V (viewType NETLIST)
        (interface (port IN) (port OUT) (port GND))
        (contents
          (instance R1 (viewRef V (cellRef RES (libraryRef PARTS))) (designator "R1"))
          (instance C1 (viewRef V (cellRef CAP (libraryRef PARTS))) (designator "C1"))
          (net IN (joined (portRef IN) (portRef A (instanceRef R1))))
          (net OUT (joined (portRef OUT) (portRef B (instanceRef R1)) (portRef &1 (instanceRef C1))))
          (instance TP1 (viewRef V (cellRef TP (libraryRef PARTS))) (designator "TP1"))
          (net MID (joined (portRef &1 (instanceRef TP1))))
          (net GND (joined (portRef GND) (portRef &2 (instanceRef C1)))))))
    (cell TOP (cellType GENERIC)
      (view V (viewType NETLIST)
        (interface)
        (contents
          (instance U5A (viewRef V (cellRef BUF2 (libraryRef PARTS))) (designator "U5")
            (portInstance IN (designator "1")) (portInstance OUT (designator "2")))
          (instance J1 (viewRef V (cellRef CONN2 (libraryRef PARTS))) (designator "J1"))
          (instance A1 (viewRef V (cellRef LED_DRV)))
          (instance B1 (viewRef V (cellRef RC)))
          (instance B2 (viewRef V (cellRef RC)))
          (net VCC (joined (portRef &1 (instanceRef J1)) (portRef VIN (instanceRef A1))
            (portRef IN (instanceRef B1)) (portRef IN (instanceRef B2))))
          (net NET_LED_CATHODE (joined (portRef CATH (instanceRef A1)) (portRef IN (instanceRef U5A))))
          (net GND (joined (portRef &2 (instanceRef J1)) (portRef GND (instanceRef B1)) (portRef GND (instanceRef B2))))
          (net OUT1 (joined (portRef OUT (instanceRef U5A)) (portRef OUT (instanceRef B1))))
          (net OUT2 (joined (portRef OUT (instanceRef B2))))))))
)
