(kicad_pcb
	(version 20240108)
	(generator "pcbnew")
	(title_block
		(title "Four Layer Stackup Fixture"))
	(general
		(thickness 1.6))
	(layers
		(0 "F.Cu" signal)
		(1 "In1.Cu" signal)
		(2 "In2.Cu" power)
		(31 "B.Cu" signal)
		(36 "B.SilkS" user)
		(37 "F.SilkS" user)
		(38 "B.Mask" user)
		(39 "F.Mask" user)
		(44 "Edge.Cuts" user)
	)
	(setup
		(stackup
			(layer "F.SilkS"
				(type "Top Silk Screen"))
			(layer "F.Mask"
				(type "Top Solder Mask")
				(thickness 0.01))
			(layer "F.Cu"
				(type "copper")
				(thickness 0.035))
			(layer "dielectric 1"
				(type "prepreg")
				(thickness 0.1)
				(material "PR1080")
				(epsilon_r 3.96)
				(loss_tangent 0.02) addsublayer
				(thickness 0.12)
				(material "PR2116")
				(epsilon_r 4.1)
				(loss_tangent 0.02))
			(layer "In1.Cu"
				(type "copper")
				(thickness 0.018))
			(layer "dielectric 2"
				(type "core")
				(thickness 1.0)
				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02))
			(layer "In2.Cu"
				(type "copper")
				(thickness 0.018))
			(layer "dielectric 3"
				(type "prepreg")
				(thickness 0.2))
			(layer "B.Cu"
				(type "copper")
				(thickness 0.035))
			(layer "B.Mask"
				(type "Bottom Solder Mask")
				(thickness 0.01))
			(layer "B.SilkS"
				(type "Bottom Silk Screen"))
			(copper_finish "ENIG")))
	(net 0 "")
	(net 1 "GND")
	(net 2 "TOP")
	(net 3 "INNER")
	(net 4 "BOTTOM")
	(gr_rect (start 0 0) (end 40 30)
		(layer "Edge.Cuts")
		(uuid "edge1"))
	(footprint "Resistor_SMD:R_0805"
		(layer "F.Cu")
		(uuid "fp-r1")
		(at 8 6 0)
		(property "Reference" "R1"
			(at 0 -2 0)
			(layer "F.SilkS"))
		(fp_line
			(start -1.5 -0.7)
			(end 1.5 -0.7)
			(stroke (width 0.12) (type solid))
			(layer "F.SilkS")
			(uuid "r1-silk"))
		(pad "1" smd roundrect
			(at -1 0)
			(size 1.2 1.4)
			(layers "F.Cu" "F.Paste" "F.Mask")
			(net 2 "TOP")
			(uuid "p-r1-1"))
		(pad "2" smd roundrect
			(at 1 0)
			(size 1.2 1.4)
			(layers "F.Cu" "F.Paste" "F.Mask")
			(net 2 "TOP")
			(uuid "p-r1-2")))
	(segment (start 9 6) (end 30 6) (width 0.5) (layer "F.Cu") (net 2) (uuid "s-top"))
	(segment (start 5 15) (end 35 15) (width 1) (layer "In1.Cu") (net 3) (uuid "s-inner"))
	(segment (start 5 24) (end 35 24) (width 0.5) (layer "B.Cu") (net 4) (uuid "s-bottom"))
	(via (at 30 6) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 2) (uuid "v1"))
	(via blind (at 20 15) (size 0.5) (drill 0.2) (layers "F.Cu" "In1.Cu") (net 3) (uuid "v2"))
	(via buried (at 25 15) (size 0.5) (drill 0.2) (layers "In1.Cu" "In2.Cu") (net 3) (uuid "v3"))
	(gr_line
		(start 2 2)
		(end 12 2)
		(stroke (width 0.15) (type solid))
		(layer "F.SilkS")
		(uuid "free-silk"))
	(gr_text "BOTTOM"
		(at 20 27 0)
		(layer "B.SilkS")
		(effects (font (size 1 1)) (justify mirror)))
	(zone
		(net 1)
		(net_name "GND")
		(layer "In2.Cu")
		(uuid "z-plane")
		(polygon
			(pts
				(xy 1 1) (xy 39 1) (xy 39 10) (xy 1 10)))))
