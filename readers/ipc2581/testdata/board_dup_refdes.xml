<?xml version="1.0" encoding="UTF-8"?>
<IPC-2581 revision="C" xmlns="http://webstds.ipc.org/2581">
  <Content>
    <DictionaryStandard units="MILLIMETER"/>
  </Content>
  <Bom name="bom">
    <BomItem quantity="2" internalPartNumber="RES-10K" packageRef="R0603">
      <RefDes name="R1" populate="TRUE"/>
      <RefDes name="R2" populate="TRUE"/>
    </BomItem>
  </Bom>
  <Ecad name="ecad">
    <CadData>
      <Layer name="TOP" layerFunction="CONDUCTOR" side="TOP" polarity="POSITIVE"/>
      <Layer name="BOTTOM" layerFunction="CONDUCTOR" side="BOTTOM" polarity="POSITIVE"/>
      <Stackup overallThickness="1.6">
        <StackupGroup name="g">
          <StackupLayer layerOrGroupRef="TOP" materialType="COPPER" thickness="0.035"/>
          <StackupLayer layerOrGroupRef="BOTTOM" materialType="COPPER" thickness="0.035"/>
        </StackupGroup>
      </Stackup>
      <Step name="step">
        <Package name="R0603" type="OTHER"/>
        <Package name="SOIC8" type="OTHER"/>
        <Component refDes="R1" packageRef="R0603" part="RES">
          <NonstandardAttribute name="VALUE" value="10K" type="STRING"/>
        </Component>
        <Component refDes="R2" packageRef="R0603" part="RES"/>
        <Component refDes="U1" packageRef="SOIC8" part="OPAMP"/>
        <Component refDes="R2" packageRef="R0603" part="RES"/>
        <!-- Three components that name no part: the fully unassigned REF**, the partly-assigned
             C?1845, and one with no designator at all. A board reader skips all three, so none of
             them reaches the netlist tier and neither does the GND pin claimed by the first. -->
        <Component refDes="REF**" packageRef="R0603" part="FIDUCIAL"/>
        <Component refDes="C?1845" packageRef="R0603" part="CAP"/>
        <Component packageRef="R0603" part="TESTPOINT"/>
        <LogicalNet name="GND" netClass="GROUND">
          <PinRef componentRef="R1" pin="2"/>
          <PinRef componentRef="U1" pin="4"/>
          <PinRef componentRef="REF**" pin="1"/>
        </LogicalNet>
        <LogicalNet name="VCC" netClass="POWER">
          <PinRef componentRef="R1" pin="1"/>
          <PinRef componentRef="U1" pin="8"/>
        </LogicalNet>
        <!-- N$17 is the case the declared role exists for: an opaque name the naming lexicon
             cannot read, whose role the source states outright. SIGNAL_ONLY carries a netClass
             that maps to no role, so it must stay role-free rather than guess. -->
        <LogicalNet name="N$17" netClass="GROUND">
          <PinRef componentRef="R2" pin="2"/>
          <PinRef componentRef="U1" pin="5"/>
        </LogicalNet>
        <LogicalNet name="SIGNAL_ONLY" netClass="SIGNAL">
          <PinRef componentRef="R2" pin="1"/>
          <PinRef componentRef="U1" pin="3"/>
        </LogicalNet>
      </Step>
    </CadData>
  </Ecad>
</IPC-2581>