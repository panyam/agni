<?xml version="1.0" encoding="UTF-8"?>
<!-- Arc casing fixture: Cadence Allegro emits clockwise="TRUE"/"FALSE" (uppercase), so a
     case-sensitive =="true" parse read every clockwise arc as counter-clockwise and swept it the
     wrong way (the "inverted arc" / balloon bug). Here the top edge is a CW semicircle from (10,4)
     to (0,4) about (5,4): swept clockwise it dips DOWN to the apex (5,-1). Read as CCW it would
     bulge UP to (5,9) instead. Units MM. -->
<IPC-2581 revision="C" xmlns="http://webstds.ipc.org/2581">
  <Content>
    <DictionaryStandard units="MILLIMETER"/>
  </Content>
  <Ecad name="ecad">
    <CadData>
      <Layer name="TOP" layerFunction="CONDUCTOR" side="TOP" polarity="POSITIVE"/>
      <Step name="step">
        <Profile>
          <Polygon>
            <PolyBegin x="0.000000" y="0.000000"/>
            <PolyStepSegment x="10.000000" y="0.000000"/>
            <PolyStepSegment x="10.000000" y="4.000000"/>
            <PolyStepCurve x="0.000000" y="4.000000" centerX="5.000000" centerY="4.000000" clockwise="TRUE"/>
            <PolyStepSegment x="0.000000" y="0.000000"/>
          </Polygon>
        </Profile>
      </Step>
    </CadData>
  </Ecad>
</IPC-2581>
