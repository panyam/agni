(edif I2CSENSOR
  (edifVersion 2 0 0) (edifLevel 0)
  (library LIB
    (technology (numberDefinition (scale 1 (e 1 -8) (unit DISTANCE))))
    (cell (rename &mcu "MCU")
      (cellType GENERIC)
      (view (rename &mcuv "sym") (viewType SCHEMATIC)
        (interface
          (port 1 (direction INPUT) (designator "1")) (port 2 (direction INPUT) (designator "2"))
          (port 3 (direction INOUT) (designator "3")) (port 4 (direction OUTPUT) (designator "4"))
          (port 5 (direction INPUT) (designator "5")) (port 6 (direction INPUT) (designator "6")))
        (symbol
          (boundingBox (rectangle (pt 0 0) (pt 400 600)))
          (figure BOX (rectangle (pt 0 0) (pt 400 600)))
          (portImplementation (name 1 (display (justify CENTERLEFT) (origin (pt 220 520)))) (connectLocation (figure GRAPHICS (dot (pt 200 600)))) (figure PIN (path (pointList (pt 200 600) (pt 200 540)))))
          (portImplementation (name 2 (display (justify CENTERLEFT) (origin (pt 220 40)))) (connectLocation (figure GRAPHICS (dot (pt 200 0)))) (figure PIN (path (pointList (pt 200 0) (pt 200 60)))))
          (portImplementation (name 3 (display (justify CENTERRIGHT) (origin (pt 380 470)))) (connectLocation (figure GRAPHICS (dot (pt 400 450)))) (figure PIN (path (pointList (pt 400 450) (pt 340 450)))))
          (portImplementation (name 4 (display (justify CENTERRIGHT) (origin (pt 380 370)))) (connectLocation (figure GRAPHICS (dot (pt 400 350)))) (figure PIN (path (pointList (pt 400 350) (pt 340 350)))))
          (portImplementation (name 5 (display (justify CENTERRIGHT) (origin (pt 380 270)))) (connectLocation (figure GRAPHICS (dot (pt 400 250)))) (figure PIN (path (pointList (pt 400 250) (pt 340 250)))))
          (portImplementation (name 6 (display (justify CENTERRIGHT) (origin (pt 380 170)))) (connectLocation (figure GRAPHICS (dot (pt 400 150)))) (figure PIN (path (pointList (pt 400 150) (pt 340 150))))))))
    (cell (rename &sensor "SENSOR")
      (cellType GENERIC)
      (view (rename &sensorv "sym") (viewType SCHEMATIC)
        (interface
          (port 1 (direction INPUT) (designator "1")) (port 2 (direction INPUT) (designator "2"))
          (port 3 (direction INOUT) (designator "3")) (port 4 (direction INPUT) (designator "4")))
        (symbol
          (boundingBox (rectangle (pt 0 0) (pt 300 400)))
          (figure BOX (rectangle (pt 0 0) (pt 300 400)))
          (portImplementation (name 1 (display (justify CENTERLEFT) (origin (pt 170 340)))) (connectLocation (figure GRAPHICS (dot (pt 150 400)))) (figure PIN (path (pointList (pt 150 400) (pt 150 340)))))
          (portImplementation (name 2 (display (justify CENTERLEFT) (origin (pt 170 40)))) (connectLocation (figure GRAPHICS (dot (pt 150 0)))) (figure PIN (path (pointList (pt 150 0) (pt 150 60)))))
          (portImplementation (name 3 (display (justify CENTERLEFT) (origin (pt 20 320)))) (connectLocation (figure GRAPHICS (dot (pt 0 300)))) (figure PIN (path (pointList (pt 0 300) (pt 60 300)))))
          (portImplementation (name 4 (display (justify CENTERLEFT) (origin (pt 20 220)))) (connectLocation (figure GRAPHICS (dot (pt 0 200)))) (figure PIN (path (pointList (pt 0 200) (pt 60 200))))))))
    (cell (rename &res "RES")
      (cellType GENERIC)
      (view (rename &resv "sym") (viewType SCHEMATIC)
        (interface (port 1 (direction INPUT) (designator "1")) (port 2 (direction INPUT) (designator "2")))
        (symbol
          (boundingBox (rectangle (pt 0 -40) (pt 300 40)))
          (figure LINE (path (pointList (pt 0 0) (pt 40 0) (pt 60 30) (pt 100 -30) (pt 140 30) (pt 180 -30) (pt 220 30) (pt 260 0) (pt 300 0))))
          (portImplementation (name 1 (display (justify CENTERRIGHT) (origin (pt 20 60)))) (connectLocation (figure GRAPHICS (dot (pt 0 0)))))
          (portImplementation (name 2 (display (justify CENTERLEFT) (origin (pt 280 60)))) (connectLocation (figure GRAPHICS (dot (pt 300 0))))))))
    (cell (rename &cap "CAP")
      (cellType GENERIC)
      (view (rename &capv "sym") (viewType SCHEMATIC)
        (interface (port 1 (direction INPUT) (designator "1")) (port 2 (direction INPUT) (designator "2")))
        (symbol
          (boundingBox (rectangle (pt -60 -70) (pt 60 70)))
          (figure LINE (path (pointList (pt -60 20) (pt 60 20))))
          (figure LINE (path (pointList (pt -60 -20) (pt 60 -20))))
          (portImplementation (name 1 (display (justify CENTERLEFT) (origin (pt 20 45)))) (connectLocation (figure GRAPHICS (dot (pt 0 70)))) (figure PIN (path (pointList (pt 0 70) (pt 0 20)))))
          (portImplementation (name 2 (display (justify CENTERLEFT) (origin (pt 20 -55)))) (connectLocation (figure GRAPHICS (dot (pt 0 -70)))) (figure PIN (path (pointList (pt 0 -70) (pt 0 -20))))))))
    (cell (rename &conn "CONN")
      (cellType GENERIC)
      (view (rename &connv "sym") (viewType SCHEMATIC)
        (interface (port 1 (direction OUTPUT) (designator "1")) (port 2 (direction OUTPUT) (designator "2")))
        (symbol
          (boundingBox (rectangle (pt 0 0) (pt 200 300)))
          (figure BOX (rectangle (pt 0 0) (pt 200 300)))
          (portImplementation (name 1 (display (justify CENTERLEFT) (origin (pt 20 240)))) (connectLocation (figure GRAPHICS (dot (pt 0 220)))) (figure PIN (path (pointList (pt 0 220) (pt 60 220)))))
          (portImplementation (name 2 (display (justify CENTERLEFT) (origin (pt 20 100)))) (connectLocation (figure GRAPHICS (dot (pt 0 80)))) (figure PIN (path (pointList (pt 0 80) (pt 60 80)))))))))
  (design I2CSENSOR
    (cellRef TOP (libraryRef LIB))
    (contents
      (page (rename P1 "Sensor")
        (instance (rename &j1 "$j1") (viewRef connv (cellRef (name &conn) (libraryRef LIB))) (transform (origin (pt 200 300))) (designator (stringDisplay "J1")))
        (instance (rename &u1 "$u1") (viewRef mcuv (cellRef (name &mcu) (libraryRef LIB))) (transform (origin (pt 800 200))) (designator (stringDisplay "U1")))
        (instance (rename &u2 "$u2") (viewRef sensorv (cellRef (name &sensor) (libraryRef LIB))) (transform (origin (pt 1800 300))) (designator (stringDisplay "U2")))
        (instance (rename &r1 "$r1") (viewRef resv (cellRef (name &res) (libraryRef LIB))) (transform (origin (pt 1400 1000))) (designator (stringDisplay "R1")))
        (instance (rename &c1 "$c1") (viewRef capv (cellRef (name &cap) (libraryRef LIB))) (transform (origin (pt 500 1500))) (designator (stringDisplay "C1")))
        (net (name VCC) (figure NET (path (pointList (pt 200 1200) (pt 1950 1200)))) (figure NET (path (pointList (pt 200 520) (pt 200 1200)))) (figure NET (path (pointList (pt 1000 800) (pt 1000 1200)))) (figure NET (path (pointList (pt 1950 700) (pt 1950 1200)))) (figure NET (path (pointList (pt 1400 1000) (pt 1400 1200)))))
        (net (name GND) (figure NET (path (pointList (pt 200 100) (pt 1950 100)))) (figure NET (path (pointList (pt 200 380) (pt 200 100)))) (figure NET (path (pointList (pt 1000 200) (pt 1000 100)))) (figure NET (path (pointList (pt 1950 300) (pt 1950 100)))))
        (net (name SDA) (figure NET (path (pointList (pt 1200 650) (pt 1200 600) (pt 1800 600)))) (figure NET (path (pointList (pt 1700 1000) (pt 1700 600)))))
        (net (name SCL) (figure NET (path (pointList (pt 1200 550) (pt 1200 500) (pt 1800 500)))))
        (net (name STUB) (figure NET (path (pointList (pt 1200 450) (pt 1350 450)))))
        (net (name NC_SPARE) (figure NET (path (pointList (pt 1200 350) (pt 1350 350)))))
        (portImplementation (name VCC (display (justify CENTERLEFT) (orientation R0) (origin (pt 1980 1220)))) (connectLocation (figure GRAPHICS (dot (pt 1950 1200)))))
        (portImplementation (name GND (display (justify CENTERLEFT) (orientation R0) (origin (pt 1980 120)))) (connectLocation (figure GRAPHICS (dot (pt 1950 100)))))
        (portImplementation (name SDA (display (justify CENTERLEFT) (orientation R0) (origin (pt 1450 630)))) (connectLocation (figure GRAPHICS (dot (pt 1450 600)))))
        (portImplementation (name SCL (display (justify CENTERLEFT) (orientation R0) (origin (pt 1450 530)))) (connectLocation (figure GRAPHICS (dot (pt 1450 500)))))
        (portImplementation (name STUB (display (justify CENTERLEFT) (orientation R0) (origin (pt 1370 470)))) (connectLocation (figure GRAPHICS (dot (pt 1350 450)))))
        (portImplementation (name NC_SPARE (display (justify CENTERLEFT) (orientation R0) (origin (pt 1370 370)))) (connectLocation (figure GRAPHICS (dot (pt 1350 350)))))))))
