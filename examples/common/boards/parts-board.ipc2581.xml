<?xml version="1.0" encoding="UTF-8"?>
<!-- A synthetic two-layer board whose packages state their body heights (agni 1352). U1 and C1
     sit on the top, J1 on the bottom, and R1's package states no height. Units MM. -->
<IPC-2581 revision="C" xmlns="http://webstds.ipc.org/2581">
  <Content>
    <DictionaryStandard units="MILLIMETER">
      <EntryStandard id="PAD_1">
        <Circle diameter="0.600000"/>
      </EntryStandard>
    </DictionaryStandard>
  </Content>
  <Ecad name="ecad">
    <CadData>
      <Layer name="TOP" layerFunction="CONDUCTOR" side="TOP" polarity="POSITIVE"/>
      <Layer name="BOTTOM" layerFunction="CONDUCTOR" side="BOTTOM" polarity="POSITIVE"/>
      <Stackup overallThickness="1.6">
        <StackupGroup name="g">
          <StackupLayer layerOrGroupRef="TOP" materialType="COPPER" thickness="0.035"/>
          <StackupLayer layerOrGroupRef="BOTTOM" materialType="COPPER" thickness="0.035"/>
        </StackupGroup>
      </Stackup>
      <Step name="step">
        <Profile>
          <Polygon>
            <PolyBegin x="0.000000" y="0.000000"/>
            <PolyStepSegment x="30.000000" y="0.000000"/>
            <PolyStepSegment x="30.000000" y="20.000000"/>
            <PolyStepSegment x="0.000000" y="20.000000"/>
            <PolyStepSegment x="0.000000" y="0.000000"/>
          </Polygon>
        </Profile>
        <Package name="SOIC8" type="OTHER" height="1.75">
          <Pin number="1" type="SURFACE"><Location x="-2.700000" y="1.905000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
          <Pin number="4" type="SURFACE"><Location x="-2.700000" y="-1.905000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
          <Pin number="5" type="SURFACE"><Location x="2.700000" y="-1.905000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
          <Pin number="8" type="SURFACE"><Location x="2.700000" y="1.905000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
        </Package>
        <Package name="C1206" type="OTHER" height="1.2">
          <Pin number="1" type="SURFACE"><Location x="-1.500000" y="0.000000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
          <Pin number="2" type="SURFACE"><Location x="1.500000" y="0.000000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
        </Package>
        <Package name="R0603" type="OTHER">
          <Pin number="1" type="SURFACE"><Location x="-0.800000" y="0.000000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
          <Pin number="2" type="SURFACE"><Location x="0.800000" y="0.000000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
        </Package>
        <Package name="HDR2" type="OTHER" height="8.5">
          <Pin number="1" type="SURFACE"><Location x="-1.270000" y="0.000000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
          <Pin number="2" type="SURFACE"><Location x="1.270000" y="0.000000"/><StandardPrimitiveRef id="PAD_1"/></Pin>
        </Package>
        <Component refDes="U1" packageRef="SOIC8" layerRef="TOP" part="OPAMP" mountType="SMT">
          <Location x="8.000000" y="10.000000"/>
        </Component>
        <Component refDes="C1" packageRef="C1206" layerRef="TOP" part="CAP" mountType="SMT">
          <Xform rotation="90.000"/>
          <Location x="16.000000" y="10.000000"/>
        </Component>
        <Component refDes="R1" packageRef="R0603" layerRef="TOP" part="RES" mountType="SMT">
          <Location x="22.000000" y="10.000000"/>
        </Component>
        <Component refDes="J1" packageRef="HDR2" layerRef="BOTTOM" part="HEADER" mountType="SMT">
          <Location x="15.000000" y="4.000000"/>
        </Component>
      </Step>
    </CadData>
  </Ecad>
</IPC-2581>
