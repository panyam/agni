(kicad_pcb (version 20221018) (generator pcbnew)
  (general (thickness 1.6))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
    (47 "F.CrtYd" user "F.Courtyard")
  )
  (net 0 "")
  (gr_rect (start 0 0) (end 20 10) (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts"))
  (footprint "demo:block" (layer "F.Cu") (at 5 5)
    (property "Reference" "U1")
    (fp_rect (start -1.2 -0.8) (end 1.2 0.8) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
    (pad "1" smd rect (at -0.8 0) (size 0.5 1) (layers "F.Cu"))
    (pad "2" smd rect (at 0.8 0) (size 0.5 1) (layers "F.Cu"))
    (model "${KIPRJMOD}/3d/block.step")
  )
  (footprint "demo:block" (layer "F.Cu") (at 10 5)
    (property "Reference" "U2")
    (fp_rect (start -1.2 -0.8) (end 1.2 0.8) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
    (pad "1" smd rect (at -0.8 0) (size 0.5 1) (layers "F.Cu"))
    (pad "2" smd rect (at 0.8 0) (size 0.5 1) (layers "F.Cu"))
    (model "${KIPRJMOD}/3d/block.step" (offset (xyz 0 0 0.5)) (scale (xyz 1 1 2)))
  )
  (footprint "Resistor_SMD:R_0402_1005Metric" (layer "F.Cu") (at 15 5)
    (property "Reference" "R1")
    (pad "1" smd rect (at -0.5 0) (size 0.5 0.6) (layers "F.Cu"))
    (pad "2" smd rect (at 0.5 0) (size 0.5 0.6) (layers "F.Cu"))
    (model "${KICAD9_3DMODEL_DIR}/Resistor_SMD.3dshapes/R_0402_1005Metric.step")
  )
  (footprint "demo:block-3x2" (layer "F.Cu") (at 5 8)
    (property "Reference" "U3")
    (fp_rect (start -1.7 -1.2) (end 1.7 1.2) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
    (pad "1" smd rect (at -1.2 0) (size 0.6 1.4) (layers "F.Cu"))
    (pad "2" smd rect (at 1.2 0) (size 0.6 1.4) (layers "F.Cu"))
    (model "${DEMOLIB}/block.step")
  )
)
