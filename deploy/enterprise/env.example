# Copy to .env beside compose.yaml and fill in every value without a default. Each *_FILE and the
# TLS paths name a file on this machine, which compose mounts read-only into the container. Keep
# those files out of any repo, readable by uid 10001 and by nobody else who needn't read them.

# The release to run. Each release's compose.yaml pins its own; set this to try another.
AGNI_VERSION=latest
# Where the images come from, for a registry mirror.
AGNI_IMAGE=ghcr.io/panyam/agni
AGNI_DS_IMAGE=ghcr.io/panyam/agnids

# The URL people open, as their browser reaches it. GitHub sends a signed-in browser back to
# <AGNI_PUBLIC_URL>/signin/github/callback/, and pushes to <AGNI_PUBLIC_URL>/hooks/github, so the
# GitHub App lists both.
AGNI_PUBLIC_URL=https://agni.example.com
# The port on this machine that serves it. Put 443 here, or keep 8443 behind your own forwarding.
AGNI_PORT=8443

# The server's certificate and its key, as PEM files. The certificate names AGNI_PUBLIC_URL's host.
AGNI_TLS_CERT=./secrets/tls.crt
AGNI_TLS_KEY=./secrets/tls.key

# A file holding 64 hex characters, which seals each person's GitHub token in the store. Make one
# with `openssl rand -hex 32 > secrets/connections.key`, and keep it with your backups of the data
# volume, since the sealed tokens can't be read without it.
AGNI_CONNECTIONS_KEY_FILE=./secrets/connections.key

# Your GitHub's REST API. For GitHub Enterprise Server it is https://<host>/api/v3. Sign-in goes
# through the same host.
AGNI_GITHUB_API=https://github.example.com/api/v3
# The GitHub App people sign in through: its client id, and a file holding its client secret.
AGNI_GITHUB_CLIENT_ID=Iv1.0000000000000000
AGNI_GITHUB_CLIENT_SECRET_FILE=./secrets/github-client-secret
# Who may sign in, comma-separated: org:<org> for an org's members, user:<login> for one person.
AGNI_GITHUB_ALLOW=org:acme
# A file holding the secret the App signs push webhooks with. Make one with
# `openssl rand -hex 32 > secrets/github-webhook-secret`, and paste the same value into the App.
AGNI_GITHUB_WEBHOOK_SECRET_FILE=./secrets/github-webhook-secret

# A folder of secret files the server reads for its own connections, mounted read-only at
# /run/agni/connections. A connection added with `--github-token file:/run/agni/connections/hw` reads
# the file hw here, and each file must be readable by uid 10001. `agni connections add --seal` keeps
# the token sealed in the data volume instead, and needs nothing here.
AGNI_CONNECTION_SECRETS=./secrets/connections

# A folder of CA certificates, as PEM files, that both servers trust beside the system's. Put the CA
# that signed your GitHub Enterprise Server's certificate here when it is your own. Leave the folder
# empty otherwise, but make it, or docker makes it owned by root.
AGNI_CA_DIR=./ca

# With --profile datasheets: the workbench's port. It serves HTTPS with the same certificate.
AGNI_DATASHEETS_PORT=8090
