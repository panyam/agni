
(edif SCHEMNET
  (edifVersion 2 0 0)
  (edifLevel 0)
  (library Lib1
    (technology
      (numberDefinition
        (scale 1 (e 1 -8) (unit DISTANCE))))
    (cell (rename &c1 "PartA")
      (cellType GENERIC)
      (view (rename &v1 "sym")
        (viewType SCHEMATIC)
        (interface
          (designator (stringDisplay "U"))
          (port (rename &1 "1") (direction INPUT) (designator (stringDisplay "1")))
          (port (rename &2 "2") (direction OUTPUT) (designator (stringDisplay "2")))))))
  (design TopDesign
    (cellRef Top (libraryRef Lib1))
    (contents
      (page (rename P1 "Sheet 1")
        (instance (rename &i1 "$i1")
          (viewRef v1 (cellRef PartA (libraryRef Lib1)))
          (designator (stringDisplay "U7"))
          (property (rename Manufacturer_PN "Manufacturer PN") (string (stringDisplay "PART-123")))
          (property Value (string (stringDisplay "10k" (display (justify CENTERLEFT) (origin (pt 320 420))))))
          (portInstance (rename &1 "1") (designator (stringDisplay "3")))
          (portInstance (rename &2 "2") (designator (stringDisplay "5"))))
        (net (rename &n1 "SIGA")
          (joined (portRef &1 (instanceRef &i1))))
        (net (rename &n2 "SIGB")
          (joined (portRef &2 (instanceRef &i1))))))))
