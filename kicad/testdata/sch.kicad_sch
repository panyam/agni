(kicad_sch
	(version 20250114)
	(generator "eeschema")
	(lib_symbols
		(symbol "test:DUAL"
			(property "Reference" "U")
			(property "Value" "DUAL")
			(symbol "DUAL_1_1"
				(pin input line (at 0 0 0) (length 2) (name "A") (number "1")))
			(symbol "DUAL_2_1"
				(pin output line (at 0 0 0) (length 2) (name "Y") (number "2"))))
		(symbol "test:R"
			(property "Reference" "R")
			(property "Value" "R")
			(symbol "R_0_1"
				(pin passive line (at 0 0 0) (length 2) (name "~") (number "1"))
				(pin passive line (at 0 0 0) (length 2) (name "~") (number "2"))))
		(symbol "test:GND"
			(property "Reference" "#PWR")
			(symbol "GND_0_1"
				(pin power_in line (at 0 0 0) (length 0) (name "GND") (number "1")))))
	(symbol (lib_id "test:DUAL") (unit 1) (uuid "u1-unit1")
		(property "Reference" "U1") (property "Value" "DUAL"))
	(symbol (lib_id "test:DUAL") (unit 2) (uuid "u1-unit2")
		(property "Reference" "U1") (property "Value" "DUAL"))
	(symbol (lib_id "test:R") (unit 1) (uuid "r1")
		(in_bom no) (on_board no) (dnp yes)
		(property "Reference" "R1") (property "Value" "10k")
		(property "MPN" "RC0603FR-0710KL") (property "Manufacturer" "Yageo")
		(property "Footprint" "Resistor_SMD:R_0603_1608Metric") (property "Datasheet" "https://example.com/r.pdf"))
	(symbol (lib_id "test:GND") (unit 1) (uuid "pwr1")
		(property "Reference" "#PWR01") (property "Value" "GND"))
	(sheet (uuid "sheet1")
		(property "Sheetname" "sub") (property "Sheetfile" "sub.kicad_sch")))