# Raw-shaped doc-IR of the TXB0104's pin function table: ONE table, exactly as a real
# producer emitted it, so the pin path is exercised against producer output rather than
# against a shape invented to suit the parser. Transcribed from TI SCES650K (Rev. K,
# APRIL 2006 - REVISED MARCH 2025), Table 4-1 "Pin Functions", page 4; cells are the
# docling output for that page, unedited.
#
# It is a FIXTURE, not a corpus entry: one table of one document, carrying the cases the
# pin path has to survive. The PDF and the full doc-IR stay outside this repo.
#
# The table is UNTITLED, like every real one, so its title has to be attached from the
# section_header block above it. The awkward cases it carries, all real:
#
#   - ONE HEADER CELL NAMING SEVERAL PACKAGES. "D, PW" and "GXU, ZXU, NMN" each head a
#     single column of designators shared by two or three bodies.
#   - SEVERAL DESIGNATORS IN ONE CELL, spaced inconsistently WITHIN one row: the NC row
#     reads "6, 9" under D/PW and "6,9" under BQA/RGY.
#   - THE ABSENCE MARKER IS AN ASCII HYPHEN, not the em-dash printed on the page. A
#     parser matching the typographic glyph reads every absence as an unparsed cell.
#   - A TYPE COLUMN THAT DECLINES TO CLASSIFY. VCCA, VCCB, GND and NC all carry "-" in
#     the I/O column, so a supply pin's function is NOT stated by the channel that
#     states it for the data pins.
#   - A ROW WITH NO DESIGNATOR IN ANY BODY. "Thermal pad" has a name and a description
#     and nothing else, which the contract permits and nothing else exercises.
#   - SUBSCRIPTS FLATTENED WITH INJECTED SPACES: "Referenced to V CCA .".
content_hash: "sha256:fixture-txb0104-pintable"
source_format: "pdf"
title: "TXB0104"
producer: "hand"
# page_count is the PAGE THIS TABLE IS ON, not the document's length: the fixture holds
# one page out of 58, and doc.Validate requires a page number within the declared count.
page_count: 4

pages {
  number: 4
  width: 612
  height: 792
  text_blocks {
    id: "p4.x30"
    text: "Table 4-1. Pin Functions"
    bbox { x: 248.86 y: 230.95 width: 114.29 height: 11.16 }
    kind: "section_header"
  }
  tables {
    id: "p4.t1"
    title: ""
    bbox { x: 55.67 y: 242.04 width: 500.25 height: 263.22 }
    rows: 16
