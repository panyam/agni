# Hand-encoded worked example for pin binding (WS10): TI TXB0104 voltage-level translator.
# Values transcribed from the datasheet cited in `docs`; provenance points at the exact table and
# page. Deliberately a FIXTURE rather than a corpus entry: it carries the few rows the contract's
# properties need, not the part's parameter set. A seeded corpus lives with its PDFs, outside this
# repo, which is what SourceDoc.locator's corpus-local posture already assumes.
#
# One real part covers everything pin binding has to survive:
#
#   - MULTI-SUPPLY. VCCA and VCCB are two supply pins with genuinely DIFFERENT limits (recommended
#     1.2-3.6 V vs 1.65-5.5 V; abs-max 4.6 V vs 6.5 V). Without pin binding both collapse into one
#     "supply" concept and a rule answers once for a part that has two answers.
#
#   - REPACKAGING. Number 11 is the data I/O "B3" in the TSSOP-14 and the "VCCB" supply in the
#     UQFN-12, so a number-keyed join compares a rail against an I/O pin's rating and looks healthy
#     doing it. B3 is here ONLY to hold that collision; its own limits are not transcribed.
#
#   - A NAME ON SEVERAL TERMINALS. "NC" is printed twice, so the name channel alone cannot resolve
#     a design pin and the tie-break has to come from the number.
#
#   - A GROUP BINDING. The continuous-current row is stated once for three terminals at once.
#
# The DSBGA column also shows why PinNumber.number is a STRING ("A2", "B2"), and the 12-pin bodies
# have no NC pin, so a PinNumber is absent rather than a sentinel.
mpn: "TXB0104"
manufacturer: "Texas Instruments"
device_class: "level translator"

docs {
  id: "sces650k"
  title: "SCES650K - APRIL 2006 - REVISED MARCH 2025"
  vendor: "Texas Instruments"
  locator: "datasheets/ti/TXB0104.pdf"
}

packages {
  id: "pw"
  name: "PW (TSSOP-14)"
  mpn_suffix: "PW"
}

packages {
  id: "rut"
  name: "RUT (UQFN-12)"
  mpn_suffix: "RUT"
}

packages {
  id: "yzt"
  name: "YZT (DSBGA-12)"
  mpn_suffix: "YZT"
}

# --- Pin function table (Table 4-1, page 4) ---

pins {
  id: "vcca"
  name: "VCCA"
  function: PIN_FUNCTION_POWER_INPUT
  description: "A-port supply voltage 1.2V <= VCCA <= 3.6V and VCCA <= VCCB."
  numbers { package_ref: "pw" number: "1" }
  numbers { package_ref: "rut" number: "1" }
  numbers { package_ref: "yzt" number: "B2" }
  prov { doc_ref: "sces650k" page: 4 table_or_figure: "Table 4-1. Pin Functions" method: "hand" confidence: 1 }
}

pins {
  id: "vccb"
  name: "VCCB"
  function: PIN_FUNCTION_POWER_INPUT
  description: "B-port supply voltage 1.65V <= VCCB <= 5.5V."
  numbers { package_ref: "pw" number: "14" }
  # 11 in the UQFN-12 is this supply pin; 11 in the TSSOP-14 is the B3 data I/O below.
  numbers { package_ref: "rut" number: "11" }
  numbers { package_ref: "yzt" number: "A2" }
  prov { doc_ref: "sces650k" page: 4 table_or_figure: "Table 4-1. Pin Functions" method: "hand" confidence: 1 }
}

pins {
  id: "gnd"
  name: "GND"
  function: PIN_FUNCTION_GROUND
  description: "Ground"
  numbers { package_ref: "pw" number: "7" }
  numbers { package_ref: "rut" number: "6" }
  numbers { package_ref: "yzt" number: "D2" }
  prov { doc_ref: "sces650k" page: 4 table_or_figure: "Table 4-1. Pin Functions" method: "hand" confidence: 1 }
}

# Present only to hold the number-11 collision against VCCB.
pins {
  id: "b3"
  name: "B3"
  function: PIN_FUNCTION_BIDIRECTIONAL
  description: "Input/output 3. Referenced to VCCB."
  numbers { package_ref: "pw" number: "11" }
  numbers { package_ref: "rut" number: "8" }
  numbers { package_ref: "yzt" number: "C1" }
  attributes { key: "function_raw" value: "I/O" }
  prov { doc_ref: "sces650k" page: 4 table_or_figure: "Table 4-1. Pin Functions" method: "hand" confidence: 1 }
}

# One NAME, two terminals, and only in the 14-pin body.
pins {
  id: "nc6"
  name: "NC"
  function: PIN_FUNCTION_NO_CONNECT
  description: "No connection. Not internally connected."
  numbers { package_ref: "pw" number: "6" }
  prov { doc_ref: "sces650k" page: 4 table_or_figure: "Table 4-1. Pin Functions" method: "hand" confidence: 1 }
}

pins {
  id: "nc9"
  name: "NC"
  function: PIN_FUNCTION_NO_CONNECT
  description: "No connection. Not internally connected."
  numbers { package_ref: "pw" number: "9" }
  prov { doc_ref: "sces650k" page: 4 table_or_figure: "Table 4-1. Pin Functions" method: "hand" confidence: 1 }
}

# --- 5.1 Absolute Maximum Ratings (page 5) ---
# These carry the table header's temperature phrase as a RAW condition, so they are captured but not
# machine-comparable, the same encoding lm1117.textproto uses.

parameters {
  name: "Supply voltage, VCCA"
  symbol: "VCCA"
  limit_kind: LIMIT_KIND_ABSOLUTE_MAX
  value { min: -0.5 max: 4.6 }
  unit: "V"
  conditions { symbol: "TA" raw: "over operating free-air temperature range (unless otherwise noted)" }
  condition_coverage: CONDITION_COVERAGE_COMPLETE
  pin_refs: "vcca"
  prov { doc_ref: "sces650k" page: 5 table_or_figure: "5.1 Absolute Maximum Ratings" method: "hand" confidence: 1 }
}

parameters {
  name: "Supply voltage, VCCB"
  symbol: "VCCB"
  limit_kind: LIMIT_KIND_ABSOLUTE_MAX
  value { min: -0.5 max: 6.5 }
  unit: "V"
  conditions { symbol: "TA" raw: "over operating free-air temperature range (unless otherwise noted)" }
  condition_coverage: CONDITION_COVERAGE_COMPLETE
  pin_refs: "vccb"
  prov { doc_ref: "sces650k" page: 5 table_or_figure: "5.1 Absolute Maximum Ratings" method: "hand" confidence: 1 }
}

# The group binding, stated once for three terminals. Printed in mA, so it also exercises the
# prefixed-unit reduction on a pin-bound row.
parameters {
  name: "Continuous current through VCCA, VCCB, or GND"
  symbol: "I"
  limit_kind: LIMIT_KIND_ABSOLUTE_MAX
  value { min: -100 max: 100 }
  unit: "mA"
  conditions { symbol: "TA" raw: "over operating free-air temperature range (unless otherwise noted)" }
  condition_coverage: CONDITION_COVERAGE_COMPLETE
  pin_refs: "vcca"
  pin_refs: "vccb"
  pin_refs: "gnd"
  prov { doc_ref: "sces650k" page: 5 table_or_figure: "5.1 Absolute Maximum Ratings" method: "hand" confidence: 1 }
}

# A part-wide row: no pin_refs, which is also what every spec seeded before pin binding says.
parameters {
  name: "Junction temperature range, TJ"
  symbol: "TJ"
  limit_kind: LIMIT_KIND_ABSOLUTE_MAX
  value { max: 150 }
  unit: "C"
  conditions { symbol: "TA" raw: "over operating free-air temperature range (unless otherwise noted)" }
  condition_coverage: CONDITION_COVERAGE_COMPLETE
  prov { doc_ref: "sces650k" page: 5 table_or_figure: "5.1 Absolute Maximum Ratings" method: "hand" confidence: 1 }
}

# --- 5.3 Recommended Operating Conditions (page 6) ---
# The TA range is a row of THIS table, so it is encoded structurally rather than as the header
# phrase: these rows are machine-comparable, and they carry the differing per-pin windows.

parameters {
  name: "Supply voltage, VCCA"
  symbol: "VCCA"
  limit_kind: LIMIT_KIND_RECOMMENDED_OPERATING
  value { min: 1.2 max: 3.6 }
  unit: "V"
  conditions { symbol: "TA" min: -40 max: 85 unit: "C" }
  condition_coverage: CONDITION_COVERAGE_COMPLETE
  pin_refs: "vcca"
  prov { doc_ref: "sces650k" page: 6 table_or_figure: "5.3 Recommended Operating Conditions" method: "hand" confidence: 1 }
}

parameters {
  name: "Supply voltage, VCCB"
  symbol: "VCCB"
  limit_kind: LIMIT_KIND_RECOMMENDED_OPERATING
  value { min: 1.65 max: 5.5 }
  unit: "V"
  conditions { symbol: "TA" min: -40 max: 85 unit: "C" }
  condition_coverage: CONDITION_COVERAGE_COMPLETE
  pin_refs: "vccb"
  prov { doc_ref: "sces650k" page: 6 table_or_figure: "5.3 Recommended Operating Conditions" method: "hand" confidence: 1 }
}
