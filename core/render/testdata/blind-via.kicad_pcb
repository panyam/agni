(kicad_pcb
	(version 20240108)
	(generator "pcbnew")
	(general
		(thickness 0.6))
	(layers
		(0 "F.Cu" signal)
		(1 "In1.Cu" signal)
		(2 "In2.Cu" signal)
		(31 "B.Cu" signal)
		(38 "B.Mask" user)
		(39 "F.Mask" user)
		(44 "Edge.Cuts" user)
	)
	(setup
		(stackup
			(layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
			(layer "F.Cu" (type "copper") (thickness 0.035))
			(layer "dielectric 1" (type "prepreg") (thickness 0.1) (material "FR4"))
			(layer "In1.Cu" (type "copper") (thickness 0.035))
			(layer "dielectric 2" (type "core") (thickness 0.26) (material "FR4"))
			(layer "In2.Cu" (type "copper") (thickness 0.035))
			(layer "dielectric 3" (type "prepreg") (thickness 0.1) (material "FR4"))
			(layer "B.Cu" (type "copper") (thickness 0.035))
			(layer "B.Mask" (type "Bottom Solder Mask"))
		))
	(net 0 "")
	(net 1 "THRU")
	(net 2 "BLIND")
	(net 3 "BURIED")
	(gr_line (start 0 0) (end 20 0) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts") (uuid "e1"))
	(gr_line (start 20 10) (end 0 10) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts") (uuid "e3"))
	(gr_line (start 20 0) (end 20 10) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts") (uuid "e2"))
	(gr_line (start 0 0) (end 0 10) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts") (uuid "e4"))
	(footprint "Connector:Pin_1"
		(layer "F.Cu")
		(uuid "fp-j1")
		(at 16 5 0)
		(property "Reference" "J1" (at 0 -2 0) (layer "F.SilkS"))
		(pad "1" thru_hole circle (at 0 0) (size 1.7 1.7) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "THRU") (uuid "p-j1-1")))
	(segment (start 4 5) (end 8 5) (width 0.25) (layer "In1.Cu") (net 3) (uuid "s-buried"))
	(via (at 4 3) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1) (uuid "v-thru"))
	(via blind (at 8 3) (size 0.45) (drill 0.2) (layers "F.Cu" "In1.Cu") (net 2) (uuid "v-blind"))
	(via buried (at 12 3) (size 0.45) (drill 0.2) (layers "In1.Cu" "In2.Cu") (net 3) (uuid "v-buried"))
)
