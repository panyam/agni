<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>agni query set — {{.Title}}</title>
<style>{{css}}</style>
</head>
<body>
<div class="wrap">

<h1>{{.Title}}</h1>
<div class="sub">
  {{if .Source}}{{.Source}} · {{end}}{{len .Sections}} queries
</div>

{{if .Preamble}}<p class="note">Shared rules:</p>
<pre class="q">{{.Preamble}}</pre>{{end}}

{{range .Sections}}
<h2>{{.Name}}</h2>
{{if .Description}}<p>{{.Description}}</p>{{end}}
{{if .Query}}<pre class="q">{{.Query}}</pre>{{end}}
{{if .Bindings}}<p class="sub">Bound: {{range $i, $b := .Bindings}}{{if $i}}, {{end}}<code>{{$b}}</code>{{end}}</p>{{end}}
{{if .Error}}
<p class="note">Could not answer: {{.Error}}</p>
{{else if .Body}}
<div class="sub">{{len .Body}} result(s)</div>
<table>
  <thead>
    <tr>{{range .Header}}<th>{{.}}</th>{{end}}</tr>
  </thead>
  <tbody>
    {{range .Body}}<tr>{{range .}}<td class="subject">{{.}}</td>{{end}}</tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p class="note">No rows matched.</p>
{{end}}
{{end}}

</div>
</body>
</html>
