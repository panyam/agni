<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>agni check — {{.Design}}</title>
<style>
  :root {
    --fg: #1f2328; --muted: #656d76; --line: #d8dee4; --bg: #ffffff; --panel: #f6f8fa;
    --pass: #1a7f37; --fail: #cf222e; --warn: #9a6700; --info: #0969da;
  }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e6edf3; --muted: #9198a1; --line: #30363d; --bg: #0d1117; --panel: #161b22;
            --pass: #3fb950; --fail: #f85149; --warn: #d29922; --info: #58a6ff; }
  }
  body { margin: 0; padding: 24px; background: var(--bg); color: var(--fg);
         font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  .wrap { max-width: 1100px; margin: 0 auto; }
  h1 { font-size: 20px; margin: 0 0 4px 0; }
  .sub { color: var(--muted); font-size: 12px; margin-bottom: 20px; }
  .sub code { background: var(--panel); padding: 1px 4px; border-radius: 3px; }
  .stats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .stat { background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
          padding: 8px 12px; min-width: 92px; }
  .stat .n { font-size: 20px; font-weight: 600; display: block; }
  .stat .l { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .note { color: var(--muted); font-size: 12px; margin: 8px 0 24px 0; }
  details { border: 1px solid var(--line); border-radius: 6px; margin-bottom: 10px; background: var(--bg); }
  details[open] { background: var(--panel); }
  summary { cursor: pointer; padding: 10px 12px; list-style: none; display: flex;
            align-items: baseline; gap: 10px; flex-wrap: wrap; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "▸"; color: var(--muted); }
  details[open] > summary::before { content: "▾"; }
  .rule { font-weight: 600; }
  .rule-summary { color: var(--muted); font-size: 12px; flex: 1 1 260px; }
  .pill { font-size: 11px; padding: 1px 7px; border-radius: 10px; border: 1px solid var(--line);
          color: var(--muted); white-space: nowrap; }
  .pill.fail { color: var(--fail); border-color: var(--fail); }
  .pill.pass { color: var(--pass); border-color: var(--pass); }
  .body { padding: 0 12px 12px 12px; background: var(--bg); }
  .prose { font-size: 13px; margin: 10px 0; }
  .prose .impact { color: var(--muted); font-style: italic; }
  .prose .remedy { border-left: 3px solid var(--info); padding-left: 8px; margin-top: 6px; }
  .tablewrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  td.o { white-space: nowrap; font-weight: 600; }
  td.o.pass { color: var(--pass); } td.o.fail { color: var(--fail); }
  td.o.inconclusive, td.o.nolimit, td.o.notconsidered { color: var(--warn); }
  td.subject { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; white-space: nowrap; }
  .terms { color: var(--muted); font-size: 12px; }
  .findings-only { border-left: 3px solid var(--warn); padding-left: 8px; color: var(--muted);
                   font-size: 12px; margin: 10px 0; }
</style>
</head>
<body>
<div class="wrap">

<h1>agni check — {{.Design}}</h1>
<div class="sub">
  {{if .Generated}}{{.Generated}}{{end}}
  {{if .ContentHash}} · <code>{{.ContentHash}}</code>{{end}}
</div>

<div class="stats">
  <div class="stat"><span class="n">{{.Totals.Findings}}</span><span class="l">findings</span></div>
  <div class="stat"><span class="n">{{.Totals.Considered}}</span><span class="l">considered</span></div>
  <div class="stat"><span class="n">{{.Totals.Pass}}</span><span class="l">pass</span></div>
  <div class="stat"><span class="n">{{.Totals.Fail}}</span><span class="l">fail</span></div>
  {{if .Totals.Inconclusive}}<div class="stat"><span class="n">{{.Totals.Inconclusive}}</span><span class="l">undecided</span></div>{{end}}
  {{if .Totals.NotConsidered}}<div class="stat"><span class="n">{{.Totals.NotConsidered}}</span><span class="l">not considered</span></div>{{end}}
  {{if .Totals.NoLimit}}<div class="stat"><span class="n">{{.Totals.NoLimit}}</span><span class="l">no limit</span></div>{{end}}
</div>

<p class="note">
  {{.Totals.RulesReporting}} rule(s) reported what they looked at.
  {{if .Totals.RulesFindingsOnly}}
  {{.Totals.RulesFindingsOnly}} reported violations only, so silence from those is not evidence of anything.
  {{end}}
</p>

{{range .Rules}}
<details {{if .Failed}}open{{end}}>
  <summary>
    <span class="rule">{{.Name}}</span>
    <span class="rule-summary">{{.Summary}}</span>
    {{if count .Counts fail}}<span class="pill fail">{{count .Counts fail}} fail</span>{{end}}
    {{if count .Counts pass}}<span class="pill pass">{{count .Counts pass}} pass</span>{{end}}
    {{if not .StatesConsideredSet}}<span class="pill">findings only</span>{{end}}
  </summary>
  <div class="body">
    <div class="prose">
      {{if .Impact}}<div class="impact">{{.Impact}}</div>{{end}}
      {{if and .Remedy .Failed}}<div class="remedy">{{.Remedy}}</div>{{end}}
    </div>

    {{if not .StatesConsideredSet}}
    <div class="findings-only">
      This rule reports violations without stating what it examined, so the rows below are what it
      found and not what it checked. Absence here is not evidence of correctness.
    </div>
    {{end}}

    <div class="tablewrap">
    <table>
      <thead><tr><th>outcome</th><th>subject</th><th>what it rests on</th></tr></thead>
      <tbody>
      {{range .Rows}}
        <tr>
          <td class="o {{outcomeClass .Outcome}}">{{outcomeLabel .Outcome}}</td>
          <td class="subject">
            {{if .URL}}<a href="{{.URL}}">{{subjectOf .}}</a>{{else}}{{subjectOf .}}{{end}}
          </td>
          <td>
            {{if .Message}}{{.Message}}{{else if .Witness}}{{.Witness}}{{else if .Reason}}{{.Reason}}{{end}}
            {{if .Terms}}<div class="terms">
              {{range $i, $t := .Terms}}{{if $i}} · {{end}}{{$t.Label}}: {{$t.Value}}{{end}}
            </div>{{end}}
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
    </div>
  </div>
</details>
{{end}}

</div>
</body>
</html>
