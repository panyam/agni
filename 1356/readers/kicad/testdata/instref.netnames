# KiCad's own net names for instref.kicad_sch, from `kicad-cli sch export netlist` (10.0.6).
# Regenerate with hack/kicad_net_names.sh; do not hand-edit. Each line is a net name, a tab,
# then the ref.pin pairs on it, so the test can pair our nets with KiCad's by their pins.
unconnected-(R2-Pad1)	R2.1
unconnected-(R2-Pad2)	R2.2
unconnected-(R5-Pad1)	R5.1
unconnected-(R5-Pad2)	R5.2
unconnected-(R7-Pad1)	R7.1
unconnected-(R7-Pad2)	R7.2
unconnected-(R?1845-Pad1)	R?1845.1
unconnected-(R?1845-Pad2)	R?1845.2
