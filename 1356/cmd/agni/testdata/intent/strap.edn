(edif STRAP (edifVersion 2 0 0) (edifLevel 0) (keywordMap (keywordLevel 0))
  (library LIB (edifLevel 0) (technology (numberDefinition))
    (cell MCU (cellType generic) (view V (viewType NETLIST) (interface (port 1 (direction INPUT)) (port 2 (direction INPUT)) (port 3 (direction INPUT)))))
    (cell RES (cellType generic) (view V (viewType NETLIST) (interface (port 1 (direction INOUT)) (port 2 (direction INOUT))))))
  (design D (cellRef TOP (libraryRef WORK)))
  (library WORK (edifLevel 0) (technology (numberDefinition))
