(edif DEMO
  (edifVersion 2 0 0) (edifLevel 0)
  (library L
    (technology (numberDefinition (scale 1 (e 1 -8) (unit DISTANCE))))
    (cell (rename &src "SRC")
      (cellType GENERIC)
      (view (rename &srcv "sym") (viewType SCHEMATIC)
        (interface (port P (direction OUTPUT) (designator "P")) (port N (direction OUTPUT) (designator "N")))
        (symbol
          (boundingBox (rectangle (pt -70 -70) (pt 70 70)))
          (figure BODY (circle (pt -70 0) (pt 70 0)))
          (portImplementation (name P (display (justify CENTERLEFT) (origin (pt 20 90)))) (connectLocation (figure GRAPHICS (dot (pt 0 70)))))
          (portImplementation (name N (display (justify CENTERLEFT) (origin (pt 20 -100)))) (connectLocation (figure GRAPHICS (dot (pt 0 -70))))))))
    (cell (rename &conn "CONN")
      (cellType GENERIC)
      (view (rename &connv "sym") (viewType SCHEMATIC)
        (interface (port A (direction INPUT) (designator "A")) (port B (direction INPUT) (designator "B")))
        (symbol
          (boundingBox (rectangle (pt 0 0) (pt 200 300)))
          (figure BOX (rectangle (pt 0 0) (pt 200 300)))
          (portImplementation (name A (display (justify CENTERLEFT) (origin (pt 20 230)))) (connectLocation (figure GRAPHICS (dot (pt 0 220)))) (figure PIN (path (pointList (pt -100 220) (pt 0 220)))))
          (portImplementation (name B (display (justify CENTERLEFT) (origin (pt 20 90)))) (connectLocation (figure GRAPHICS (dot (pt 0 80)))) (figure PIN (path (pointList (pt -100 80) (pt 0 80))))))))
    (cell (rename &res "RES")
      (cellType GENERIC)
      (view (rename &resv "sym") (viewType SCHEMATIC)
        (interface (port 1 (direction INPUT) (designator "1")) (port 2 (direction INPUT) (designator "2")))
        (symbol
          (boundingBox (rectangle (pt 0 -40) (pt 300 40)))
          (figure LINE (path (pointList (pt 0 0) (pt 40 0) (pt 60 30) (pt 100 -30) (pt 140 30) (pt 180 -30) (pt 220 30) (pt 260 0) (pt 300 0))))
          (portImplementation (name 1 (display (justify CENTERRIGHT) (origin (pt 20 60)))) (connectLocation (figure GRAPHICS (dot (pt 0 0)))))
          (portImplementation (name 2 (display (justify CENTERLEFT) (origin (pt 280 60)))) (connectLocation (figure GRAPHICS (dot (pt 300 0))))))))
    (cell (rename &cap "CAP")
      (cellType GENERIC)
      (view (rename &capv "sym") (viewType SCHEMATIC)
        (interface (port 1 (direction INPUT) (designator "1")) (port 2 (direction INPUT) (designator "2")))
        (symbol
          (boundingBox (rectangle (pt -60 -70) (pt 60 70)))
          (figure LINE (path (pointList (pt -60 20) (pt 60 20))))
          (figure LINE (path (pointList (pt -60 -20) (pt 60 -20))))
          (portImplementation (name 1 (display (justify CENTERLEFT) (origin (pt 20 45)))) (connectLocation (figure GRAPHICS (dot (pt 0 70)))) (figure PIN (path (pointList (pt 0 70) (pt 0 20)))))
          (portImplementation (name 2 (display (justify CENTERLEFT) (origin (pt 20 -55)))) (connectLocation (figure GRAPHICS (dot (pt 0 -70)))) (figure PIN (path (pointList (pt 0 -70) (pt 0 -20))))))))
    (cell out_flat
      (cellType GENERIC)
      (view out_flat (viewType GRAPHIC) (interface)
        (contents
          (boundingBox (rectangle (pt 0 -50) (pt 150 50)))
          (figure LINE (path (pointList (pt 0 0) (pt 50 50) (pt 150 50) (pt 150 -50) (pt 50 -50) (pt 0 0))))))))
  (design D
    (cellRef Top (libraryRef L))
    (contents
      (page (rename P1 "Demo")
        (instance (rename &v1 "$v1") (viewRef srcv (cellRef (name &src) (libraryRef L))) (transform (origin (pt 150 450))) (designator (stringDisplay "V1")))
        (instance (rename &j1 "$j1") (viewRef connv (cellRef (name &conn) (libraryRef L))) (transform (origin (pt 400 300))) (designator (stringDisplay "J1")))
        (instance (rename &r1 "$r1") (viewRef resv (cellRef (name &res) (libraryRef L))) (transform (origin (pt 600 520))) (designator (stringDisplay "R1")))
        (instance (rename &r2 "$r2") (viewRef resv (cellRef (name &res) (libraryRef L))) (transform (origin (pt 600 380))) (designator (stringDisplay "R2")))
        (instance (rename &c1 "$c1") (viewRef capv (cellRef (name &cap) (libraryRef L))) (transform (origin (pt 1050 450))) (designator (stringDisplay "C1")))
        (instance (rename &o1 "$o1") (viewRef out_flat (cellRef out_flat (libraryRef L))) (transform (origin (pt 1250 520))) (designator (stringDisplay "")))
        (instance (rename &o2 "$o2") (viewRef out_flat (cellRef out_flat (libraryRef L))) (transform (origin (pt 1250 380))) (designator (stringDisplay "")))
        (net (name TOP) (figure NET (path (pointList (pt 150 520) (pt 600 520)))))
        (net (name TOP2) (figure NET (path (pointList (pt 900 520) (pt 1250 520)))))
        (net (name BOT) (figure NET (path (pointList (pt 150 380) (pt 600 380)))))
        (net (name BOT2) (figure NET (path (pointList (pt 900 380) (pt 1250 380)))))
        (portImplementation (name OUT_HI (display (justify CENTERLEFT) (orientation R0) (origin (pt 1270 540)))) (connectLocation (figure GRAPHICS (dot (pt 1250 520)))))
        (portImplementation (name OUT_LO (display (justify CENTERLEFT) (orientation R0) (origin (pt 1270 400)))) (connectLocation (figure GRAPHICS (dot (pt 1250 380)))))))))
