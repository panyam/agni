(edif REVC
  (edifVersion 2 0 0)
  ; rev-a with two renames in one revision, one of which ALSO changed.
  ;
  ; SIG -> DATA is a clean rename, recovered by the exact connection signature.
  ; CLK -> OSC is the case the exact pass cannot see: the same revision that renamed it also
  ; probed it, so its signature moved and it falls out as a New plus a Deleted. TP1 is a test
  ; point, so the near-match pass reads the change as churn and recovers the pairing.
  (design REVC (cellRef TOP (libraryRef LIB)))
  (library LIB
    (cell TOP
      (view V (viewType NETLIST) (interface)
        (contents
          (instance R1 (viewRef V (cellRef RES)) (designator "R1"))
          (instance R2 (viewRef V (cellRef RES)) (designator "R2"))
          (instance R3 (viewRef V (cellRef RES)) (designator "R3"))
          (instance U1 (viewRef V (cellRef MCU)) (designator "U1"))
          (instance TP1 (viewRef V (cellRef TESTPOINT)) (designator "TP1"))
          (net VCC (joined (portRef 1 (instanceRef R1)) (portRef 1 (instanceRef U1))))
          (net GND (joined (portRef 2 (instanceRef R1)) (portRef 2 (instanceRef U1))))
          (net DATA (joined (portRef 1 (instanceRef R2)) (portRef 3 (instanceRef U1))))
          (net OSC (joined (portRef 1 (instanceRef R3)) (portRef 4 (instanceRef U1)) (portRef 1 (instanceRef TP1))))
          (net OLD (joined (portRef 2 (instanceRef R2)) (portRef 5 (instanceRef U1)))))))))
