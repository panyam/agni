
(edif DEMO_SCHEMATIC
  (edifVersion 2 0 0)
  (edifLevel 0)
  (library Lib1
    (technology
      (numberDefinition
        (scale 1 (e 1 -8) (unit DISTANCE))))
    (cell (rename &c_res "Resistor")
      (cellType GENERIC)
      (view (rename &v_sym "sym")
        (viewType SCHEMATIC)
        (interface
          (port (rename &1 "1") (direction INPUT) (designator "1"))
          (port (rename &2 "2") (direction INPUT) (designator "2")))
        (symbol
          (boundingBox (rectangle (pt 0 -100) (pt 200 0)))
          (figure BOX (rectangle (pt 0 -100) (pt 200 0)))
          (portImplementation
            (name &1)
            (connectLocation (figure GRAPHICS (dot (pt 200 -50))))
            (figure PIN (path (pointList (pt 150 -50) (pt 200 -50))))))))
    (cell (rename &c_mcu "MCU")
      (cellType GENERIC)
      (view (rename &v_sym "sym")
        (viewType SCHEMATIC)
        (interface
          (port (rename &1 "SCL") (direction INPUT) (designator "SCL")))
        (symbol
          (boundingBox (rectangle (pt 0 -200) (pt 400 0)))
          (figure BOX (rectangle (pt 0 -200) (pt 400 0)))
          (portImplementation
            (name &1)
            (connectLocation (figure GRAPHICS (dot (pt 400 -100))))
            (figure PIN (path (pointList (pt 350 -100) (pt 400 -100)))))))))
  (design TopDesign
    (cellRef Top (libraryRef Lib1))
    (viewMap
      (instanceBackAnnotate
        (instanceRef &i_pull (viewRef v_sym))
        (designator "R1001"))
      (instanceBackAnnotate
        (instanceRef &i_mcu (viewRef v_sym))
        (designator "U101")))
    (contents
      (page (rename P1 "Pull-up sheet")
        (pageSize (rectangle (pt 0 0) (pt 1000 800)))
        (instance (rename &i_pull "$i_pull")
          (viewRef v_sym (cellRef Resistor (libraryRef Lib1)))
          (transform (origin (pt 300 400)))
          (designator (stringDisplay "R4")))
        (net (rename &n_scl "I2C_SCL")
          (joined (portRef &1 (instanceRef &i_pull)))
          (figure NET (path (pointList (pt 100 400) (pt 500 400)))))
      (page (rename P2 "MCU sheet")
        (pageSize (rectangle (pt 0 0) (pt 1000 800)))
        (instance (rename &i_mcu "$i_mcu")
          (viewRef v_sym (cellRef MCU (libraryRef Lib1)))
          (transform (origin (pt 200 300))))
        (net (rename &n_mcu "I2C_SCL")
          (joined (portRef &1 (instanceRef &i_mcu)))
          (figure NET (path (pointList (pt 400 300) (pt 600 300)))))))))
