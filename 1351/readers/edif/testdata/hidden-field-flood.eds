
(edif HIDDENFIELDFLOOD
  (edifVersion 2 0 0)
  (edifLevel 0)
  (keywordMap (keywordLevel 0))
  (status
    (written
      (timestamp 2026 7 28 0 0 0)
      (author "Agni test fixtures")
      (program "hand-authored")))
  (comment "Redistributable repro for the EDIF placed-field visibility flood (WS1-037 follow-up).")
  (comment "Contains NO organization-specific data: all text is lorem ipsum placeholder.")
  (comment "A schematic EDIF export records a display origin for nearly every property but marks")
  (comment "most (visible (false)); only a few (typically Value) are (visible (true)). A reader")
  (comment "that ignores the flag stamps every hidden attribute onto the drawing, flooding it")
  (comment "with tiny overlapping text.")
  (comment "Render before/after: agni render --layout faithful --sheet 1 hidden-field-flood.eds")
  (library Lib1
    (technology
      (numberDefinition
        (scale 1 (e 1 -8) (unit DISTANCE)))
      (figureGroup ATTRIBUTE
        (color 100 100 0)
        (textHeight 12000)))
    (cell (rename &c1 "Res")
      (cellType GENERIC)
      (view (rename &v1 "sym")
        (viewType SCHEMATIC)
        (interface
