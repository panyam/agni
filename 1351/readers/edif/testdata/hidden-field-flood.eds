            (connectLocation (figure GRAPHICS (dot (pt 0 0))))
            (figure PIN (path (pointList (pt -40 0) (pt 0 0)))))
          (portImplementation
            (name &2)
            (connectLocation (figure GRAPHICS (dot (pt 80 0))))
            (figure PIN (path (pointList (pt 80 0) (pt 120 0)))))))))
