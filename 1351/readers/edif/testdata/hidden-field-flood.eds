          (port (rename &2 "2") (direction OUTPUT) (designator "2")))
        (symbol
          (boundingBox (rectangle (pt -40 -30) (pt 120 30)))
          (figure BOX (rectangle (pt 0 -20) (pt 80 20)))
          (portImplementation
