# KiCad's own net names for hier_samelabel_root.kicad_sch, from `kicad-cli sch export netlist` (10.0.6).
# Regenerate with hack/kicad_net_names.sh; do not hand-edit. Each line is a net name, a tab,
# then the ref.pin pairs on it, so the test can pair our nets with KiCad's by their pins.
/Y	R5.1
/sub/VCC	R104.1
VCC	R3.1 R4.1
W	R102.1 R103.1
X	R1.1 R2.1
Y	R101.1
unconnected-(R1-Pad2)	R1.2
unconnected-(R101-Pad2)	R101.2
unconnected-(R102-Pad2)	R102.2
unconnected-(R103-Pad2)	R103.2
unconnected-(R104-Pad2)	R104.2
unconnected-(R2-Pad2)	R2.2
unconnected-(R3-Pad2)	R3.2
unconnected-(R4-Pad2)	R4.2
unconnected-(R5-Pad2)	R5.2
