(edif STRAPGRP (edifVersion 2 0 0) (edifLevel 0) (keywordMap (keywordLevel 0))
  (library LIB (edifLevel 0) (technology (numberDefinition))
    (cell PHY (cellType generic) (view V (viewType NETLIST) (interface (port 1 (direction INPUT)) (port 2 (direction INPUT)) (port 3 (direction INPUT)))))
    (cell RES (cellType generic) (view V (viewType NETLIST) (interface (port 1 (direction INOUT)) (port 2 (direction INOUT))))))
  (design D (cellRef TOP (libraryRef WORK)))
  (library WORK (edifLevel 0) (technology (numberDefinition))
    (cell TOP (cellType generic)
      (view V (viewType NETLIST) (interface)
        (contents
          (instance U12 (viewRef V (cellRef PHY (libraryRef LIB))) (designator "U12"))
          (instance U13 (viewRef V (cellRef PHY (libraryRef LIB))) (designator "U13"))
          ; U12: PHYAD = 0b001 = 1 (only the LSB pulled high)
          (instance R1 (viewRef V (cellRef RES (libraryRef LIB))) (designator "R1"))
          (instance R2 (viewRef V (cellRef RES (libraryRef LIB))) (designator "R2"))
          (instance R3 (viewRef V (cellRef RES (libraryRef LIB))) (designator "R3"))
          ; U13: also 0b001 = 1. Each strap is individually correct; the clash is only across devices.
          (instance R4 (viewRef V (cellRef RES (libraryRef LIB))) (designator "R4"))
          (instance R5 (viewRef V (cellRef RES (libraryRef LIB))) (designator "R5"))
          (instance R6 (viewRef V (cellRef RES (libraryRef LIB))) (designator "R6"))
          (net 3V3 (joined (portRef 1 (instanceRef R3)) (portRef 1 (instanceRef R6))))
          (net GND (joined (portRef 1 (instanceRef R1)) (portRef 1 (instanceRef R2))
                           (portRef 1 (instanceRef R4)) (portRef 1 (instanceRef R5))))
          (net PHYAD2 (joined (portRef 1 (instanceRef U12)) (portRef 2 (instanceRef R1))))
          (net PHYAD1 (joined (portRef 2 (instanceRef U12)) (portRef 2 (instanceRef R2))))
          (net PHYAD0 (joined (portRef 3 (instanceRef U12)) (portRef 2 (instanceRef R3))))
          (net PHY2AD2 (joined (portRef 1 (instanceRef U13)) (portRef 2 (instanceRef R4))))
          (net PHY2AD1 (joined (portRef 2 (instanceRef U13)) (portRef 2 (instanceRef R5))))
          (net PHY2AD0 (joined (portRef 3 (instanceRef U13)) (portRef 2 (instanceRef R6)))))))))
