# Copy to .env beside compose.yaml to change the defaults.

# The release to run. Each release's compose.yaml pins its own; set this to try another.
AGNI_VERSION=latest
# Where the images come from, for a registry mirror or a locally built image.
AGNI_IMAGE=ghcr.io/panyam/agni
AGNI_DS_IMAGE=ghcr.io/panyam/agnids
# Your design folders, mounted read-only at /designs. Each subfolder is a design or a project.
AGNI_DESIGNS=./designs
# The viewer's port on this machine.
AGNI_PORT=8080
# With --profile datasheets: your datasheet PDFs, and the workbench's port.
AGNI_DATASHEETS=./datasheets
AGNI_DATASHEETS_PORT=8090
